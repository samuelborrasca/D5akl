;;--------------------------------------------------CONFIG
(defcfg
process-unmapped-keys yes
concurrent-tap-hold yes
chords-v2-min-idle 50
)


;;---------------------------------VARIABLES
(defvar
  streak-count 3
  streak-time 450
  tap-timeout 200
  hold-timeout 250
  chord-timeout 30

  lkeys (
    q w e r t
    a s d f g
    z x c v b
  1 2
  )

  rkeys (
    y u i o p
    h j k l ;
    n m ,  . /
3 4
  )

)

;;----------------------------------------DEFSRC

(defsrc
	‹🖰	🖰›	🔇	🔉	🔊				🔅	🔆	⌨💡+	⌨💡−
	q	w	e	r	t				y	u	i	o	p	
	a	s	d	f	g				h	j	k	l	;	 		
	z	x	c	v	b				n	m	,	.	/
					1	2	3	4			
)

;;------------------------------------------------------ TEMPLATES

(deftemplate layerlock (layer)
	(switch 
		((base-layer base)) (multi (layer-switch $layer) (on-physical-idle 30000 tap-vkey basereturn)) break
		() (on-press tap-vkey basereturn) break
	)
)

(deftemplate flowtap (flow tap)
  (switch 
    ((key-timing $streak-count less-than $streak-time)) $flow break
    () $tap break
  )
)


(deftemplate charmodkeys (char mod keys)
  (t! flowtap

;;while typing (in "flow" mode, meaning 3 keys have been pressed in the last 450ms), any key within $keys pressed within timeout will immediately trigger tap action
    (tap-hold-release-keys $tap-timeout $hold-timeout $char $mod $keys)

;;while not in flow mode, only a key pressed AND released within $keys within timeout will trigger tap action; allows stacking modifiers, since the stacked modifiers are not released
    (tap-hold-release-tap-keys-release $tap-timeout $hold-timeout $char $mod () $keys)
  )
)

(deftemplate lwinkey (char)
	(t! flowtap
		(tap-hold-release-keys $tap-timeout $hold-timeout $char ‹❖ (q w e r t a s d f g z x c v b 1 2 ,) )
		(tap-hold-release-tap-keys-release $tap-timeout $hold-timeout $char ‹❖ (,) (q w e r t a s d f g z x c v b 1 2))
	)
	;;(tap-hold-release $tap-timeout $hold-timeout $char ‹❖)
)

(deftemplate rwinkey (char)
	(t! flowtap
		(tap-hold-release-keys $tap-timeout $hold-timeout $char ❖› (y u i o p h j k l ; n m , . / 3 4 c) )
		(tap-hold-release-tap-keys-release $tap-timeout $hold-timeout $char ❖› (c) (y u i o p h j k l ; n m , . / 3 4))
	)
	;;(tap-hold-release $tap-timeout $hold-timeout $char ❖›)
)

(deftemplate sfsmagic () 
(switch 
	;;logic check 
	;;if: input key is a pinky key and the previous key press was on the same side as that pinky key
	((	or
		(and 	
			(or
				(and (key-history c 1) (input-history real w 2))
				(and (key-history k 1) (input-history real e 2))
				(and (key-history w 1) (input-history real r 2))
				(input-history real t 2)
				(and (key-history e 1) (input-history real s 2))
				(and (key-history t 1) (input-history real d 2))
				(and (key-history r 1) (input-history real f 2))
				(and (key-history y 1) (input-history real g 2))
				(and (key-history s 1) (input-history real x 2))
				(and (key-history d 1) (input-history real c 2))
				(and (key-history m 1) (input-history real v 2))
				(and (key-history v 1) (input-history real b 2))
				(and (key-history u 1) (input-history real 1 2))
				(and (key-history i 1) (input-history real 2 2))
			)
			(or 
				(input-history real a 1) 
				(input-history real z 1)
			)
		)
		(and 
			(or
				(and (key-history g 1) (input-history real o 2))
				(and (key-history f 1) (input-history real i 2))
				(and (key-history b 1) (input-history real u 2))
				(input-history real y 2)
				(and (key-history e 1) (input-history real l 2))
				(and (key-history n 1) (input-history real k 2))
				(and (key-history l 1) (input-history real j 2))
				(and (key-history y 1) (input-history real h 2))
				(and (key-history s 1) (input-history real . 2))
				(and (key-history p 1) (input-history real , 2))
				(and (key-history h 1) (input-history real m 2))
				(and (key-history j 1) (input-history real n 2))
				(and (key-history o 1) (input-history real 4 2))
				(and (key-history a 1) (input-history real	3 2))	
			) 
			(or
				(input-history real ; 1)
				(input-history real / 1)
			)
		)
	))
	;;action: output letter depends on 2nd to last pressed key
	(switch 
		((and (input-history real w 3) (key-history c 2) )) (macro s) break
		;;kat rule: if key sequence is [k a {right pinky}], output is [kat]. otherwise k_d
		((and (input-history real e 3) (key-history k 2) (input-history real 3 2) )) t break
		((and (input-history real e 3) (key-history k 2) )) d break
		;;wom rule: if key sequence is [w o {right pinky}], output is [wom]. otherwise w_v
		((and (input-history real r 3) (key-history w 2) (input-history real 4 2) )) m break
		((and (input-history real r 3) (key-history w 2) )) v break
		((input-history real t 3)) (macro r) break
		((and (input-history real s 3) (key-history e 2) )) c break
		;;tak rule: if key sequence is [t a {right pinky}], output is [tak]. otherwise t_d
		((and (input-history real d 3) (key-history t 2) (input-history real 3 2) )) k break
		((and (input-history real d 3) (key-history t 2) )) (macro d) break
		((and (input-history real f 3) (key-history r 2) )) w break
		((and (input-history real g 3) (key-history y 2) )) r break
		((and (input-history real x 3) (key-history s 2) )) c break
		((and (input-history real c 3) (key-history d 2) )) (macro t) break
		((and (input-history real v 3) (key-history m 2) )) w break
		((and (input-history real b 3) (key-history v 2) )) r break
		((and (input-history real 1 3) (key-history u 2) )) i break
		((and (input-history real 2 3) (key-history i 2) )) u break
		
		((and (input-history real o 3) (key-history g 2) )) (macro s) break
		((and (input-history real i 3) (key-history f 2) )) (macro n) break
		;;beh rule: if key sequence is [b e {pinky}], output is [beh]. otherwise b_l
		((and (input-history real u 3) (key-history b 2) (or (input-history real s 2) (input-history real l 2)) )) h break
		((and (input-history real u 3) (key-history b 2) )) (macro l) break
		((input-history real y 3)) l break
		((and (input-history real l 3) (key-history e 2) )) g break
		((and (input-history real k 3) (key-history n 2) )) f break 
		((and (input-history real j 3) (key-history l 2) )) (macro b) break 
		((and (input-history real h 3) (key-history y 2) )) (macro l) break 
		((and (input-history real . 3) (key-history s 2) )) (macro g) break
		((and (input-history real , 3) (key-history p 2) )) (macro n) break
		((and (input-history real m 3) (key-history h 2) )) (macro b) break
		((and (input-history real n 3) (key-history j 2) )) (macro b) break
		((and (input-history real 4 3) (key-history o 2) )) a break
		((and (input-history real 3 3) (key-history a 2) )) o break
	)
	break
	() (macro spc) break
)
)



;;--------------------------------------VIRTUAL KEYS

(defvirtualkeys

;;this is used to switch back to base layer after locking to a non-base layer followed by 15s of physical idle
basereturn (layer-switch base)

;;chorded characters need to be triggered with virtual keys to work with modifiers properly
z z
x x
q q
o o
a a
i i
u u

⏎ ⏎
⭾ ⭾
⎋ ⎋
␡ ␡
;;backspace is triggered by a virtual key so i can stack it with modifiers but keep the held repeat behavior using tap-hold
⌫ ⌫

;;bigram combos are triggered with virtual keys so they don't trigger before a tap-hold key is released; see https://jtroo.github.io/config.html#chordsv2-processing-order
ec (macro e c)
kt (macro k t)
wr (macro w r)
es (fork (macro e s) (macro S-e (unmod s)) (‹⇧ ⇧›))
dt (macro d t)
rm (macro r m)
rv (macro r v)
ui (fork (macro u i) (macro S-u (unmod i)) (‹⇧ ⇧›))

bl (fork (macro b l) (macro S-b (unmod l)) (‹⇧ ⇧›))
nf (macro n f)
eg (macro e g)
bj (macro b j)
hl (macro h l)
np (macro n p)
;;es2 is used to specify which repeat key responds to which es combo
es2 (fork (macro e s) (macro S-e (unmod s)) (‹⇧ ⇧›))
oa (macro o a)
)

;;----------------------------ALIASES
(defalias

;;layer keys
;;one-shot base layer for sym layer
  B1 (one-shot-release 5000 (layer-while-held baseshot))

AR  (t! layerlock nav)
AH (layer-while-held nav)
A1 (one-shot-release 10000 (layer-while-held navshot))
u (t! charmodkeys u @AH (2))

SY (t! layerlock sym)
SH (layer-while-held sym)
S1 (one-shot-release 10000 (layer-while-held symshot))
i (t! charmodkeys i @SH (1))

NU (t! layerlock num)
NH (layer-while-held num)
N1 (one-shot-release 10000 (layer-while-held numshot))
a (t! charmodkeys a @NH (4))

;;sym2 layer doesn't really need locking
S2 (layer-while-held sym2)
o (t! charmodkeys o @S2 (3))

;;mods

;;base layer
;;left side
e (t! charmodkeys (macro e) ‹⎇ $lkeys)
t (t! charmodkeys t ‹⎈ $lkeys)
r (t! charmodkeys r ‹⇧ $lkeys) 
d (t! lwinkey d)

;;right side
e2 (t! charmodkeys (macro e) ‹⎇ $rkeys)
n (t! charmodkeys n ⎈› $rkeys)
l (t! charmodkeys l ⇧› $rkeys)
p (t! rwinkey p)

;;nav layer
;;right side
' (tap-hold-release $tap-timeout $hold-timeout ' ‹⎇)
- (tap-hold-release $tap-timeout $hold-timeout - ⎈›)
; (tap-hold-release $tap-timeout $hold-timeout ; ⇧›)
. (tap-hold-release $tap-timeout $hold-timeout . ❖›)

;;num layer
;;left side
4 (t! charmodkeys (macro Digit4) ‹⎇ $lkeys)
5 (t! charmodkeys (macro Digit5) ‹⎈ $lkeys)
6 (t! charmodkeys (macro Digit6) ‹⇧ $lkeys)
2 (t! lwinkey (macro Digit2))

;;right side
4b (t! charmodkeys (macro Digit4) ‹⎇ $lkeys)
5b (t! charmodkeys (macro Digit5) ⎈› $rkeys)
6b (t! charmodkeys (macro Digit6) ⇧› $rkeys)
2b (t! rwinkey (macro Digit2))

;;misc

  / (tap-hold $tap-timeout $hold-timeout 🔣/ (macro 🔣/ 🔣/))

Cw (caps-word-toggle 10000)

  € 🔣€
  lp (unicode "(")
  rp (unicode ")")

ä (fork 🔣ä 🔣Ä (‹⇧ ⇧›))
ö (fork 🔣ö 🔣Ö (‹⇧ ⇧›))

;;doubled non-modifier characters are tapped with macro so they can both output if pressed at the same time
s (macro s)
y (macro y)

;;auto shift letters
C (tap-hold $tap-timeout $hold-timeout c (macro S-c))
K (tap-hold $tap-timeout $hold-timeout k (macro S-k))
W (tap-hold $tap-timeout $hold-timeout w (macro S-w))
Ä (tap-hold $tap-timeout $hold-timeout 🔣ä 🔣Ä)
E (tap-hold $tap-timeout $hold-timeout e (macro S-e))
T (tap-hold $tap-timeout $hold-timeout t (macro S-t))
R (tap-hold $tap-timeout $hold-timeout r (macro S-r))
Y (tap-hold $tap-timeout $hold-timeout y (macro S-y))
S (tap-hold $tap-timeout $hold-timeout s (macro S-s))
D (tap-hold $tap-timeout $hold-timeout d (macro S-d))
M (tap-hold $tap-timeout $hold-timeout m (macro S-m))
V (tap-hold $tap-timeout $hold-timeout v (macro S-v))
U (tap-hold $tap-timeout $hold-timeout u (macro S-u))
I (tap-hold $tap-timeout $hold-timeout i (macro S-i))
Ö (tap-hold $tap-timeout $hold-timeout 🔣ö 🔣Ö)
B (tap-hold $tap-timeout $hold-timeout b (macro S-b))
F (tap-hold $tap-timeout $hold-timeout f (macro S-f))
G (tap-hold $tap-timeout $hold-timeout g (macro S-g))
L (tap-hold $tap-timeout $hold-timeout l (macro S-l))
N (tap-hold $tap-timeout $hold-timeout n (macro S-n))
J (tap-hold $tap-timeout $hold-timeout j (macro S-j))
H (tap-hold $tap-timeout $hold-timeout h (macro S-h))
P (tap-hold $tap-timeout $hold-timeout p (macro S-p))
A (tap-hold $tap-timeout $hold-timeout a (macro S-a))
O (tap-hold $tap-timeout $hold-timeout o (macro S-o))

;;sym2 layer symbols
≈ 🔣≈
≠ 🔣≠
α 🔣α
β 🔣β
γ 🔣γ
δ 🔣δ
Δ 🔣Δ
∞ 🔣∞
± 🔣±
· 🔣·

⇐ 🔣⇐
⇔ 🔣⇔
⇒ 🔣⇒
≥ 🔣≥
≤ 🔣≤
∢ 🔣∢
π 🔣π
↑ 🔣↑
← 🔣←
↓ 🔣↓
→ 🔣→
∧ 🔣∧
∨ 🔣∨

∛ 🔣∛
√ 🔣√
fx (macro f ␣ @lp x @rp ␣ )
∫ 🔣∫
∈ 🔣∈

;;magic/repeat keys

sm (t! sfsmagic)
	
)

;;--------------------------------------------CHORDS------------------------------------------------


(defchordsv2 

;;-----------------------Left side

;;------------horizontal combos
(w e) (on-press tap-vkey ⎋) $chord-timeout all-released ()
(e r) (multi (on-press tap-vkey ⌫) (tap-hold $tap-timeout 500 XX ⌫)) $chord-timeout all-released ()
(s d) (on-press tap-vkey o) $chord-timeout all-released (nav navshot sym symshot num numshot sym2)
(d f) (on-press tap-vkey a) $chord-timeout all-released (nav navshot sym symshot num numshot sym2)
(x c) (on-press tap-vkey ⏎) $chord-timeout all-released ()
(c v) (on-press tap-vkey ⭾) $chord-timeout all-released ()
(w r) (on-press tap-vkey z) $chord-timeout all-released (nav navshot sym symshot num numshot sym2)
(s f) (on-press tap-vkey x) $chord-timeout all-released (nav navshot sym symshot num numshot sym2)
(x v) (on-press tap-vkey q) $chord-timeout all-released (nav navshot sym symshot num numshot sym2)

;;-----------vertical combos
(w s) (on-press tap-vkey ec) $chord-timeout all-released (nav navshot sym symshot num numshot sym2)
(e d) (on-press tap-vkey kt) $chord-timeout all-released (nav navshot sym symshot num numshot sym2)
(r f) (on-press tap-vkey wr) $chord-timeout all-released (nav navshot sym symshot num numshot sym2)
(s x) (on-press tap-vkey es) $chord-timeout all-released (nav navshot sym symshot num numshot sym2)
(d c) (on-press tap-vkey dt) $chord-timeout all-released (nav navshot sym symshot num numshot sym2)
(f v) (on-press tap-vkey rm) $chord-timeout all-released (nav navshot sym symshot num numshot sym2)
(g b) (on-press tap-vkey rv) $chord-timeout all-released (nav navshot sym symshot num numshot sym2)
(1 2) (on-press tap-vkey ui) $chord-timeout all-released (nav navshot sym symshot num numshot sym2)


;;-----------------------Right side

;;------------horizontal combos
(o i) (on-press tap-vkey ␡) $chord-timeout all-released ()
(i u) (multi (on-press tap-vkey ⌫) (tap-hold $tap-timeout 500 XX ⌫)) $chord-timeout all-released ()
(l k)  (on-press tap-vkey u) $chord-timeout all-released (nav navshot sym symshot num numshot sym2)
(k j) (on-press tap-vkey i) $chord-timeout all-released (nav navshot sym symshot num numshot sym2)
(. ,) (on-press tap-vkey ⏎) $chord-timeout all-released ()
(, m) (on-press tap-vkey ⭾) $chord-timeout all-released ()
(o u) (on-press tap-vkey z) $chord-timeout all-released (nav navshot sym symshot num numshot sym2)
(l j) (on-press tap-vkey x) $chord-timeout all-released (nav navshot sym symshot num numshot sym2)
(. m) (on-press tap-vkey q) $chord-timeout all-released (nav navshot sym symshot num numshot sym2)

;;-----------vertical combos
(o l) (on-press tap-vkey eg) $chord-timeout all-released (nav navshot sym symshot num numshot sym2)
(i k) (on-press tap-vkey nf) $chord-timeout all-released (nav navshot sym symshot num numshot sym2)
(u j) (on-press tap-vkey bl) $chord-timeout all-released (nav navshot sym symshot num numshot sym2)
(l .) (on-press tap-vkey es2) $chord-timeout all-released (nav navshot sym symshot num numshot sym2)
(k ,) (on-press tap-vkey np) $chord-timeout all-released (nav navshot sym symshot num numshot sym2)
(j m) (on-press tap-vkey hl) $chord-timeout all-released (nav navshot sym symshot num numshot sym2)
(h n) (on-press tap-vkey bj) $chord-timeout all-released (nav navshot sym symshot num numshot sym2)
(3 4) (on-press tap-vkey oa) $chord-timeout all-released (nav navshot sym symshot num numshot sym2)
)


;;---------------------------------LAYERS


(deflayer base
	‹🖰	🖰›	🔇	🔉	🔊				🔅	🔆	⌨💡+	⌨💡−
	•	c	k	w	@ä				@ö	b	f	g	•	
	@sm	@e	@t	@r	@y				@y 	@l	@n	@e2 	@sm	 		
	@sm	@s	@d	m	v				j	h	@p	@s 	@sm 
					@u	@i		@a	@o	
)

(deflayer baseshot
	‹🖰	🖰›	🔇	🔉	🔊				🔅	🔆	⌨💡+	⌨💡−
	•	@C	@K	@W	@Ä				@Ö	@B	@F	@G	•	
	•	@E	@T	@R	@Y				@Y	@L	@N	@E	•	 		
	•	@S	@D	@M	@V				@J	@H	@P	@S	•
					@U	@I		@A	@O	
)

(deflayer nav
	‹🖰	🖰›	🔇	🔉	🔊				🔅	🔆	⌨💡+	⌨💡−
	•	C-x	C-c	C-v	🔊				•	S-;	S--	S-'	•	
	🔇 ◀	▲	▶	🔉				S-2	@;	@-	@'	␣	 		
	@Cw ↖	▼	↘	@AR				•	,	@.	S-`	`
					@B1  •		@N1 @S1		
)

(deflayer navshot
	‹🖰	🖰›	🔇	🔉	🔊				🔅	🔆	⌨💡+	⌨💡−
	•	C-x	C-c	C-v	🔊				•	S-;	S--	S-'	•	
	🔇 ◀	▲	▶	🔉				S-2	;	-	'	␣	 		
	•	 ↖	▼	↘	•				•	,	.	S-`	`
					•	•		• 	•		
)

(deflayer sym
	‹🖰	🖰›	🔇	🔉	🔊				🔅	🔆	⌨💡+	⌨💡−
	•	S-,	S-[	@lp	S-6				@€	@rp	S-]	S-.	•	
	␣	S-8	@/	[	S-4				S-/	]	S-=	=	␣	 		
	␣	 S-5 \	S-\	@SY				•	S-1	S-3	S-7	␣
					•  @B1		@N1 @A1		
)

(deflayer symshot
	‹🖰	🖰›	🔇	🔉	🔊				🔅	🔆	⌨💡+	⌨💡−
	•	S-,	S-[	@lp	S-6				@€	@rp	S-]	S-.	•	
	␣	S-8	@/	[	S-4				S-/	]	S-=	=	␣	 		
	␣	 S-5 \	S-\	•				•	S-1	S-3	S-7	␣
					•  	•		•	•		
)

(deflayer num
	‹🖰	🖰›	🔇	🔉	🔊				🔅	🔆	⌨💡+	⌨💡−
	•	7	8	9	•				•	9	8	7	•	
	0	@4 	@5 	@6	•				•	@6b @5b @4b 0	 		
	0	1	@2	3	•				@NU 3	@2b	1	0
					@A1 @S1		@B1	 •	
)

(deflayer numshot
	‹🖰	🖰›	🔇	🔉	🔊				🔅	🔆	⌨💡+	⌨💡−
	•	7	8	9	•				•	9	8	7	•	
	0	4 	5 	6	•				•	6 	5 	4 	0 		
	0	1	2	3	•				•	3	2	1	0
					• 	•		•	 •	
)

;; ≈≠γαΔ ⇐≥≤∢ ⇔⇒∛√ 
;; ∞±βδ· π↑←∧ ∫↓→∨∈

(deflayer sym2
	‹🖰	🖰›	🔇	🔉	🔊				🔅	🔆	⌨💡+	⌨💡−
	@≈	@≠	@±	@·	@∞				@Δ	@α	@β	@γ	@δ	
	␣	@⇐	@≤	@≥	@∢				@π	@←	@↑	@→	␣	 		
	@⇔	@⇒	@∛	@√	@fx				@∫	@∧	@↓	@∨	@∈
					•	•		•	•	
)
